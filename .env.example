# Copy this file to .env and fill in the testnet wallet key.
# NEVER put a real wallet key here. This project runs on testnet only
# (Ethereum Sepolia). Generate a fresh wallet for it and fund it from the
# Circle testnet faucet at https://faucet.circle.com (choose Ethereum
# Sepolia). The buyer only signs payment authorizations; it needs test
# USDC but no test ETH for gas.
TELEGRAPH_WALLET_PRIVATE_KEY=0x...

# Optional spending limits. These can only lower the built-in caps
# (max $0.02 per call, $1.00 per run); they can never raise them.
# LISTINGCHECK_MAX_PRICE_USDC=0.02
# LISTINGCHECK_BUDGET_USDC=1.00

# Optional: point at a different Telegraph node.
# TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
